# TechPulse Engine — copy to .env and fill in (never commit .env)
# Output publishing: PAT with least-privilege `contents:write` on just-userhere/Output only
OUTPUT_TOKEN=
OUTPUT_REPOSITORY=just-userhere/Output
# Optional: override report date (YYYY-MM-DD, interpreted in Asia/Kolkata). Empty = today IST.
TARGET_DATE=
# Optional LLM for summarization only (deterministic fallback is default). Leave empty to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tuning overrides (optional, defaults in config/sources.yaml)
NEWS_MINIMUM=
NEWS_MAXIMUM=
FRESHNESS_WINDOW_HOURS=
